rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Tour packages should be publicly readable
    match /tour_packages/{packageSlug} {
      allow read: if true;
      allow write: if request.auth != null; // For now, only authenticated (admin) can write
    }

    // Bookings can be created by anyone, but only read/updated/deleted by an admin
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null; // For now, only authenticated (admin) can manage
    }
    
    // Availability data can be read by anyone, but only managed by an admin
    match /availability/{docId} {
      allow read: if true;
      allow write: if request.auth != null; // For now, only authenticated (admin) can manage
    }

    // Gallery images are publicly readable, but only managed by an admin
    match /gallery/{imageId} {
      allow read: if true;
      allow create, delete: if request.auth != null; // For now, only authenticated (admin) can manage
    }

    // Package prices are publicly readable, but only managed by an admin
    match /packages/{packageSlug} {
      allow read: if true;
      allow write: if request.auth != null; // For now, only authenticated (admin) can manage
    }
    
    // Site configuration is publicly readable, but only managed by an admin
    match /site_config/{configId} {
       allow read: if true;
       allow write: if request.auth != null; // For now, only authenticated (admin) can manage
    }
  }
}