rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // WARNING: Because you are not using Firebase Auth, all these rules are set to public.
    // Anyone with your Firebase Config can theoretically write to your database.
  
    match /tour_packages/{packageSlug} {
      allow read, write: if true;
    }

    match /bookings/{bookingId} {
      allow read, write: if true; 
    }
    
    match /availability/{docId} {
      allow read, write: if true; 
    }

    match /gallery/{imageId} {
      allow read, write: if true; 
    }

    match /packages/{packageSlug} {
      allow read, write: if true; 
    }
    
    match /site_config/{configId} {
       allow read, write: if true; 
    }
    
    match /admin_credentials/{userId} {
      allow read: if true;
      allow write: if false; // Protect the password hash from being changed by attackers
    }
  }
}