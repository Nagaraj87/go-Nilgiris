rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public read/write to bookings for new tour bookings
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Allow public read/write to gallery for admin management and client viewing
    match /gallery/{imageId} {
      allow read, write: if true;
    }

    // Allow public read/write to availability for admin management and client viewing
    match /availability/{availabilityId} {
      allow read, write: if true;
    }
    
    // Allow public read/write to packages for price management and client viewing
    match /packages/{packageId} {
        allow read, write: if true;
    }

    // Allow public read/write to site_config for contact info management
    match /site_config/{configId} {
      allow read, write: if true;
    }
  }
}
