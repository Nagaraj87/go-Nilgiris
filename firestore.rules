rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bookings/{document=**} {
      allow read, write: if true;
    }
    match /availability/{document=**} {
        allow read, write: if true;
    }
    match /gallery/{document=**} {
        allow read, write: if true;
    }
    match /site_config/{document=**} {
        allow read, write: if true;
    }
  }
}
