rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read on site_config (for hero image), but no public write.
    // Admin panel writes will be authenticated.
    match /site_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null; // Rule for admin (to be improved later)
    }

    // Allow anyone to create bookings, but only authenticated users to manage them.
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null; // Rule for admin
    }
    
    // Allow public read for gallery images
    match /gallery/{imageId} {
      allow read: if true;
      allow create, delete: if request.auth != null; // Rule for admin
    }

    // Allow management of availability by admins
    match /availability/{availabilityId} {
        allow read, write: if request.auth != null; // Rule for admin
    }
  }
}
