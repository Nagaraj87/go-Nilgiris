
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read/write for bookings
    match /bookings/{bookingId=**} {
      allow read, write: if true;
    }

    // Allow public read/write for gallery images
    match /gallery/{imageId=**} {
      allow read, write: if true;
    }

    // Allow public read/write for availability
    match /availability/{availabilityId=**} {
      allow read, write: if true;
    }

    // Allow public read/write for package prices
    match /packages/{packageId=**} {
      allow read, write: if true;
    }

    // Allow public read on site config, but restrict write
    match /site_config/{configId} {
      allow read: if true;
      allow write: if true; // In a real app, this would be restricted to admins
    }

  }
}

    