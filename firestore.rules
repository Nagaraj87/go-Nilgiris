
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read/write access to bookings for the app to function
    match /bookings/{document=**} {
      allow read, write: if true;
    }

    // Allow public read access to blocked dates for the calendar
    match /blocked_dates/{date} {
       allow read: if true;
    }

    // Allow admins to write to blocked dates
    match /blocked_dates/{date} {
      allow write: if request.auth != null; // For a real app, you'd check for an admin claim
    }

    // Allow public read access to blocked seats for the seat chart
    match /blocked_seats/{seat} {
      allow read: if true;
    }

    // Allow admins to write to blocked seats
     match /blocked_seats/{seat} {
      allow write: if request.auth != null; // For a real app, you'd check for an admin claim
    }

    // Allow public read/write access to gallery for the app to function
    match /gallery/{document=**} {
      allow read, write: if true;
    }
  }
}
