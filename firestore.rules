
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allows creating bookings and admin access
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
    
    // Allows managing gallery images
    match /gallery/{imageId} {
      allow read, write: if true;
    }
    
    // Allows managing seat availability
    match /availability/{availabilityId} {
      allow read, write: if true;
    }
    
    // Allows managing package prices
    match /packages/{packageSlug} {
       allow read, write: if true;
    }

    // Allows managing site-wide configuration like contact info
    match /site_config/{configId} {
      allow read, write: if true;
    }
  }
}
